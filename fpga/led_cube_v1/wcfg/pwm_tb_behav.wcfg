<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="pwm_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="pwm_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0fs"></ZoomStartTime>
      <ZoomEndTime time="16000001fs"></ZoomEndTime>
      <Cursor1Time time="3333333fs"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="166"></NameColumnWidth>
      <ValueColumnWidth column_width="152"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="12" />
   <wvobject fp_name="/pwm_tb/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/start" type="logic">
      <obj_property name="ElementShortName">start</obj_property>
      <obj_property name="ObjectShortName">start</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/done_out" type="logic">
      <obj_property name="ElementShortName">done_out</obj_property>
      <obj_property name="ObjectShortName">done_out</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/uut/state" type="array">
      <obj_property name="ElementShortName">state[31:0]</obj_property>
      <obj_property name="ObjectShortName">state[31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/uut/count" type="array">
      <obj_property name="ElementShortName">count[15:0]</obj_property>
      <obj_property name="ObjectShortName">count[15:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/uut/pwm_count" type="array">
      <obj_property name="ElementShortName">pwm_count[7:0]</obj_property>
      <obj_property name="ObjectShortName">pwm_count[7:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/uut/max_cycles" type="array">
      <obj_property name="ElementShortName">max_cycles[31:0]</obj_property>
      <obj_property name="ObjectShortName">max_cycles[31:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/pixel" type="array">
      <obj_property name="ElementShortName">pixel[23:0]</obj_property>
      <obj_property name="ObjectShortName">pixel[23:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/pwm_red_out" type="logic">
      <obj_property name="ElementShortName">pwm_red_out</obj_property>
      <obj_property name="ObjectShortName">pwm_red_out</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/pwm_green_out" type="logic">
      <obj_property name="ElementShortName">pwm_green_out</obj_property>
      <obj_property name="ObjectShortName">pwm_green_out</obj_property>
   </wvobject>
   <wvobject fp_name="/pwm_tb/pwm_blue_out" type="logic">
      <obj_property name="ElementShortName">pwm_blue_out</obj_property>
      <obj_property name="ObjectShortName">pwm_blue_out</obj_property>
   </wvobject>
</wave_config>
